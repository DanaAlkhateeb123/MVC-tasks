@{
    string[] products = (string[])ViewData["array"];
}

<div class="container py-5">
    <h1 class="text-center text-primary mb-4">
        @ViewData["Page Title"]
    </h1>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="text-muted">Manager Name</h5>
                    <p class="fs-4 mb-0">
                        @ViewData["Manager Name"]
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="text-muted">Number of Products</h5>
                    <p class="fs-4 mb-0">
                        @ViewData["Number of Products"]
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (string item in products)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card border-primary shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="mb-0">@item</h5>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
