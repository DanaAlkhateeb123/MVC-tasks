@using task66.Models
@model Order

<h1>Order Details</h1>

<p><strong>ID:</strong> @Model.Id</p>
<p><strong>Customer Name:</strong> @Model.CustomerName</p>
<p><strong>Order Date:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
<p><strong>Total Price:</strong> @Model.TotalPrice.ToString("0.00")</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Employee:</strong> @(Model.Employee?.FullName)</p>

<a asp-controller="Order" asp-action="Index" class="btn btn-secondary">
    Back to Orders
</a>