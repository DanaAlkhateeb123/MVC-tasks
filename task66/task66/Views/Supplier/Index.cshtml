@using task66.Models
@model List<Supplier>

<h1>Suppliers</h1>

<p>
    <a asp-controller="Supplier" asp-action="Create" class="btn btn-primary">
        Add New Supplier
    </a>
</p>

@if (Model.Count == 0)
{
    <p>No suppliers found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.Id</td>
                    <td>@supplier.Name</td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.Email</td>
                    <td>
                        <a asp-controller="Supplier"
                           asp-action="Edit"
                           asp-route-id="@supplier.Id"
                           class="btn btn-primary">Edit</a>
                       </td>
                           <td>
                               <a asp-controller="Supplier"
                           asp-action="Details"
                           asp-route-id="@supplier.Id"
                           class="btn btn-info">Details</a>
                       </td>
                           <td>
                            <a class="btn btn-danger"
                               asp-controller="Supplier"
                               asp-action="Delete"
                               asp-route-id="@supplier.Id">
                                Delete
                            </a>
                        </td>
                   
                </tr>
            }
        </tbody>
    </table>
}