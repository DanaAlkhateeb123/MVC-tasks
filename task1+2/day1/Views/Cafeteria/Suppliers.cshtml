@{
    Layout = "_SimpleLayout";
}

<h1>Suppliers</h1>

@{
    string[] arr = {"Fresh Food Company",
        "Happy Drinks Company",
        "Daily Supplies Company" };
}

@foreach (var item in arr)
{
    <p>@item</p>
}


@if (arr.Length >= 3)
{
    <p>We have enough suppliers.</p>
}
else
{
    <p>We need more suppliers.</p>
}
