@using task66.Models
@model Supplier

<h1>Add Supplier</h1>

@using (Html.BeginForm("Create", "Supplier", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.Name)

        @Html.TextBoxFor(
            m => m.Name,
            new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Phone)

        @Html.TextBoxFor(
            m => m.Phone,
            new { @class = "form-control", type = "tel" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Email)

        @Html.TextBoxFor(
            m => m.Email,
            new { @class = "form-control", type = "email" })
    </div>

    <button type="submit" class="btn btn-success">
        Save
    </button>
}

<p>
    @Html.ActionLink("Back to Suppliers", "Index")
</p>