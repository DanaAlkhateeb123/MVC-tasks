@using task66.Models
@model List<Employee>

<h1>Employees</h1>

<p>
    <a asp-controller="Employee" asp-action="Create" class="btn btn-primary">
        Add New Employee
    </a>
</p>

@if (Model.Count == 0)
{
    <p>No employees found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Position</th>
                <th>Salary</th>
                <th>Hire Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Email</td>
                    <td>@employee.Position</td>
                    <td>@employee.Salary.ToString("0.00")</td>
                    <td>@employee.HireDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-controller="Employee"
                           asp-action="Edit"
                           asp-route-id="@employee.Id"
                           class="btn btn-primary">Edit</a>

                        <a asp-controller="Employee"
                           asp-action="Details"
                           asp-route-id="@employee.Id"
                           class="btn btn-info">Details</a>

                        <a asp-controller="Employee"
                           asp-action="Delete"
                           asp-route-id="@employee.Id"
                           class="btn btn-danger"
                           onclick="return confirm('Delete this employee?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}