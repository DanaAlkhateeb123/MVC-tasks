@using task66.Models
@model List<Category>

<h1>Categories</h1>

<p>
    @Html.ActionLink(
        "Add New Category",
        "Create",
        "Category",
        null,
        new { @class = "btn btn-primary" })
</p>

@if (Model.Count == 0)
{
    <p>No categories found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                </tr>
            }
        </tbody>
    </table>
}