@using task66.Models
@model List<Order>

<h1>Orders</h1>

<p>
    <a asp-controller="Order" asp-action="Create" class="btn btn-primary">
        Add New Order
    </a>
</p>

@if (Model.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Customer Name</th>
                <th>Order Date</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Employee</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.CustomerName</td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@order.TotalPrice.ToString("0.00")</td>
                    <td>@order.Status</td>
                    <td>@(order.Employee?.FullName)</td>
                    <td>
                        <a asp-controller="Order" asp-action="Edit"
                           asp-route-id="@order.Id" class="btn btn-primary">Edit</a>

                        <a asp-controller="Order" asp-action="Details"
                           asp-route-id="@order.Id" class="btn btn-info">Details</a>

                        <a asp-controller="Order" asp-action="Delete"
                           asp-route-id="@order.Id" class="btn btn-danger"
                           onclick="return confirm('Delete this order?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}